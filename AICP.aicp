@aicp version=5 repo=rpgGTSuite updated=2026-08-11
@stack lang=java build=gradle-wrapper-9.7.0 package=rpggtsuite.base source=[src/main/java/] tests=junit5 ci=none
@cmd test=./gradlew test
@agent read this file then README.md; verify claims against src/ before editing; run ./gradlew test after changes
@avoid Main.java gitignored and untracked (.gitignore:27); do not assume an entrypoint file exists
@mod base kind=domain entry=[src/main/java/rpggtsuite/base/] test=[src/test/java/rpggtsuite/base/] owns=[AbilityScore,AbilityType,Alignment,Armor,ArmorCategory,Character,CharacterClass,Charisma,Condition,Constitution,Creature,DamageType,Dexterity,Dice,Die,Intelligence,Inventory,Item,Master,Player,ProficiencyBonus,Race,Room,Sheet,Size,Skill,Skills,Spell,SpellSchool,Strength,Weapon,WeaponCategory,Wisdom]
@inv character-is-creature Character extends Creature source=path:src/main/java/rpggtsuite/base/Character.java:5
@inv character-has-sheet Character constructs a Sheet on creation source=path:src/main/java/rpggtsuite/base/Character.java:11
@inv ability-is-skill AbilityScore extends Skills; concrete abilities are Strength/Dexterity/Constitution/Intelligence/Wisdom/Charisma source=path:src/main/java/rpggtsuite/base/AbilityScore.java:3
@inv ability-modifier-formula AbilityScore.getModifier returns floorDiv(value-10, 2), the 5e ability modifier source=path:src/main/java/rpggtsuite/base/AbilityScore.java:11
@inv dice-roll-range Dice.roll returns 1..sides; default sides=20; sides>=1 enforced source=path:src/main/java/rpggtsuite/base/Dice.java:28
@inv inventory-weight-limit Inventory.addItem rejects items exceeding remaining weight capacity source=path:src/main/java/rpggtsuite/base/Inventory.java:46
@inv password-hashed Player stores only the SHA-256 password hash source=path:src/main/java/rpggtsuite/base/Player.java:56
@inv skills-are-non-negative Skills constructor and setValue reject negative values source=path:src/main/java/rpggtsuite/base/Skills.java:8
@inv skills-check-uses-die Skills.check succeeds when a rolled Die is at or below the skill value source=path:src/main/java/rpggtsuite/base/Skills.java:24
@inv proficiency-bonus-table ProficiencyBonus.forLevel implements the 5e table: 2 + floor((level-1)/4), level>=1 source=path:src/main/java/rpggtsuite/base/ProficiencyBonus.java:11
@inv sheet-starts-level-one Sheet defaults to level 1; setLevel rejects values below 1 source=path:src/main/java/rpggtsuite/base/Sheet.java:30
@inv expertise-requires-proficiency Sheet.addSkillExpertise throws unless the skill is already a proficiency; removing proficiency also drops expertise source=path:src/main/java/rpggtsuite/base/Sheet.java:205
@inv heavy-armor-ignores-dex Armor.armorClassWith ignores the dexterity modifier when category is HEAVY, otherwise applies it capped by maxDexterityBonus source=path:src/main/java/rpggtsuite/base/Armor.java:34
@resolver domain-model intent="understand RPG base classes" route=[src/main/java/rpggtsuite/base/Creature.java,src/main/java/rpggtsuite/base/Character.java,src/main/java/rpggtsuite/base/Room.java,src/main/java/rpggtsuite/base/Inventory.java]
@resolver character-sheet intent="understand character sheet, abilities, and skills" route=[src/main/java/rpggtsuite/base/Sheet.java,src/main/java/rpggtsuite/base/AbilityScore.java,src/main/java/rpggtsuite/base/Skills.java,src/main/java/rpggtsuite/base/Skill.java,src/main/java/rpggtsuite/base/ProficiencyBonus.java]
@resolver dnd-scheme intent="understand the D&D 5e SRD scheme (races, classes, equipment, spells)" route=[src/main/java/rpggtsuite/base/Race.java,src/main/java/rpggtsuite/base/CharacterClass.java,src/main/java/rpggtsuite/base/Weapon.java,src/main/java/rpggtsuite/base/Armor.java,src/main/java/rpggtsuite/base/Spell.java]
# note: java-library targets Java 11 bytecode for future Android consumption (build.gradle)
# note: tests are characterization tests over existing behavior; TDD from new features on
# note: README plans creation/game modules and mobile/desktop GUI; not implemented
# note: Room.checkPassword compares the room code in plaintext; low sensitivity, no hashing
# note: D&D scheme covers SRD-open mechanics (abilities, races, classes, skills, equipment, spells as data);
#       no combat resolution engine, no spell-slot economy, no feats/backgrounds, no full spell/monster catalog
